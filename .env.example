# Anthropic API Key (Required for live Claude Sonnet 4-6 / 3.7 integration)
# Get yours at: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Anthropic Model to use (default: claude-sonnet-4-6, fallback: claude-3-7-sonnet-20250219 or claude-3-5-sonnet-20241022)
ANTHROPIC_MODEL=claude-sonnet-4-6

# Server Port (default: 3001)
PORT=3001

# Node Environment ('development' or 'production')
NODE_ENV=development

# Optional: Cloud Database URL (if set, overrides local JSON storage)
# DATABASE_URL=
